# =============================================================================
# Root .env — consumed by docker-compose.yml (build args for the frontend)
# Backend secrets live separately in server/.env (see server/.env.example)
# Frontend dev-time values live in frontend/.env (see frontend/.env.example)
# =============================================================================

# Supabase — get these from Supabase Dashboard → Project Settings → API Keys
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Leave EMPTY for the docker-compose setup (nginx proxies /api to the backend).
# Only set this if the frontend is hosted separately from the backend, e.g.
# VITE_API_BASE_URL=https://api.your-domain.com
VITE_API_BASE_URL=
